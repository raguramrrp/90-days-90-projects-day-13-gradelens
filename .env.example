# ==============================================================================
# GradeLens - Academic Performance Analytics & Weakness Detection Platform
# Environment Configuration Template
# ==============================================================================

# Database Engine: 'postgresql' or 'sqlite'
# If PostgreSQL is selected, GradeLens will connect to your PostgreSQL instance.
# If PostgreSQL is unavailable, it reports the issue with connection diagnostics.
DATABASE_TYPE=sqlite

# PostgreSQL Connection Details (when DATABASE_TYPE=postgresql)
PGHOST=localhost
PGPORT=5432
PGDATABASE=gradelens_db
PGUSER=postgres
PGPASSWORD=your_secure_password_here

# SQLite Database Path (when DATABASE_TYPE=sqlite or fallback)
SQLITE_DB_PATH=data/gradelens.db

# Weakness Detection Engine Thresholds (%)
WEAKNESS_THRESHOLD=60.0
STRONG_THRESHOLD=75.0
MONITORING_THRESHOLD=74.9
MIN_ATTEMPTS_FOR_ASSESSMENT=2

# Application Settings
APP_ENV=development
APP_PORT=8501
ENABLE_DEMO_AUTH=true
DEFAULT_ROLE=Student
SHOW_STUDENT_RANKING=true
